---
// The landing page, rebuilt in the flat/Swiss language. Every string comes
// from the locale files; the only literals are technical (wav · 48kHz) or the
// wordmark itself. Structure and section order are unchanged from the previous
// site, so translations, hreflang and the sitemap all keep working as-is.
//
// GA4: every download / coffee anchor keeps its data-ga-id, which is what
// Base.astro's click handler reports as link_id ('nav' | 'hero' | 'footer-cta').
import type { LocaleCode } from '../i18n/config';
import { LOCALES, localeUrl } from '../i18n/config';
import { getStrings } from '../i18n/utils';
import { DMG, COFFEE, REPO, RELEASE_NOTES, SHA256, SUMSIGHT } from '../links';
import AppleMark from './AppleMark.astro';
import RecorderCard from './RecorderCard.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const current = LOCALES.find((l) => l.code === locale)!;
const legalPrefix = ''; // legal pages are English-only, served from the root
---
<SiteNav locale={locale} />

<main>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow" set:html={t.hero.eyebrow} />
          <h1 class="h-display hero-h1" set:html={t.hero.h1} />
          <p class="hero-sub">{t.hero.sub}</p>
          <div class="hero-ctas">
            <a href={DMG} data-ga-id="hero" class="btn btn-red">
              <AppleMark />
              {t.hero.ctaDownload}
            </a>
            <a href={COFFEE} data-ga-id="hero" class="btn btn-ghost" target="_blank" rel="noopener">
              {t.hero.ctaCoffee}
            </a>
          </div>
        </div>

        <div class="hero-figure">
          <RecorderCard locale={locale} />
        </div>
      </div>

      <div class="hero-req">
        <span>{t.hero.req1}</span>
        <span>{t.hero.req2}</span>
        <span>{t.download.fine3}</span>
        <span>{t.download.fine4}</span>
        <span>{t.hero.req3}</span>
      </div>
    </div>
  </section>

  <!-- ── Features ─────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">{t.features.eyebrow}</div>
        <h2 class="h-display section-h2" set:html={t.features.h2} />
      </div>

      <div class="feat-grid">
        <div class="feat-card">
          <svg class="feat-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <rect x="1.5" y="7" width="33" height="22" rx="3.5" stroke="currentColor" stroke-width="2" />
            <path d="M1.5 13.5h33" stroke="currentColor" stroke-width="2" />
            <circle cx="27" cy="10.25" r="2.5" fill="currentColor" />
          </svg>
          <h3 class="feat-title">{t.features.card1.title}</h3>
          <p class="feat-desc">{t.features.card1.desc}</p>
        </div>

        <div class="feat-card">
          <svg class="feat-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <path
              d="M3 18 Q6.5 7, 10 18 Q13.5 29, 17 18 Q20.5 7, 24 18 Q27.5 29, 33 18"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <h3 class="feat-title">{t.features.card2.title}</h3>
          <p class="feat-desc">{t.features.card2.desc}</p>
        </div>

        <div class="feat-card">
          <svg class="feat-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <rect x="3" y="26" width="4" height="7" rx="1.5" fill="currentColor" opacity="0.35" />
            <rect x="9" y="17" width="4" height="16" rx="1.5" fill="currentColor" opacity="0.55" />
            <rect x="15" y="9" width="4" height="24" rx="1.5" fill="currentColor" />
            <rect x="21" y="13" width="4" height="20" rx="1.5" fill="currentColor" opacity="0.75" />
            <rect x="27" y="21" width="4" height="12" rx="1.5" fill="currentColor" opacity="0.45" />
          </svg>
          <h3 class="feat-title">{t.features.card3.title}</h3>
          <p class="feat-desc">{t.features.card3.desc}</p>
        </div>

        <div class="feat-card">
          <svg class="feat-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <path
              d="M18 3L21.8 13.2L32 18L21.8 22.8L18 33L14.2 22.8L4 18L14.2 13.2L18 3Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            />
          </svg>
          <h3 class="feat-title">{t.features.card4.title}</h3>
          <p class="feat-desc">{t.features.card4.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">{t.how.eyebrow}</div>
        <h2 class="h-display section-h2" set:html={t.how.h2} />
      </div>

      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3 class="step-title">{t.how.step1.title}</h3>
          <p class="step-desc">{t.how.step1.desc}</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3 class="step-title">{t.how.step2.title}</h3>
          <p class="step-desc">{t.how.step2.desc}</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3 class="step-title">{t.how.step3.title}</h3>
          <p class="step-desc">{t.how.step3.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Per-app teaser ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="per-app-stage">
        <div class="per-app-ambient" aria-hidden="true"></div>
        <div class="per-app-card per-app-card--glass">
          <div>
            <div class="badge">{t.perApp.badge}</div>
          </div>
          <div>
            <h2 class="h-display per-app-h2" set:html={t.perApp.h2} />
            <p class="per-app-desc">{t.perApp.desc}</p>
            <div class="chips" aria-label={t.perApp.badge}>
              <div class="chip">Ableton Live</div>
              <div class="chip">Logic Pro</div>
              <div class="chip">GarageBand</div>
              <div class="chip">{t.perApp.chipAny}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Download ─────────────────────────────────────────────────────── -->
  <section class="section" id="download">
    <div class="wrap">
      <div class="dl-grid">
        <div>
          <div class="eyebrow">{t.download.eyebrow}</div>
          <h2 class="h-display dl-h2">{t.download.h2}</h2>
          <p class="dl-sub">{t.download.sub}</p>
          <div class="dl-ctas">
            <a href={DMG} data-ga-id="footer-cta" class="btn btn-red">
              <AppleMark />
              {t.download.ctaDownload}
            </a>
            <a
              href={COFFEE}
              data-ga-id="footer-cta"
              class="btn btn-ghost"
              target="_blank"
              rel="noopener"
            >
              {t.download.ctaCoffee}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- ── Footer ─────────────────────────────────────────────────────────── -->
<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-id">
        <div class="footer-brand">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          <span class="footer-name">Home Rec</span>
          <span class="footer-meta">macOS app</span>
        </div>

        <nav class="footer-links" aria-label="Home Rec">
          <a href={`${legalPrefix}/privacy`}>{t.footer.privacy}</a>
          <a href={`${legalPrefix}/terms`}>{t.footer.terms}</a>
          <a href={REPO} target="_blank" rel="noopener">{t.footer.github} ↗</a>
          <a href={RELEASE_NOTES} target="_blank" rel="noopener">{t.download.releaseNotes} ↗</a>
          <a href={SHA256} target="_blank" rel="noopener">{t.download.sha256} ↗</a>
        </nav>
      </div>

      <details class="lang-menu">
        <summary aria-label={`${t.switcher.label} — ${current.label}`}>
          {current.label}
          <svg
            width="8"
            height="5"
            viewBox="0 0 9 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M1 1.25 4.5 4.75 8 1.25" />
          </svg>
        </summary>
        <nav aria-label={t.switcher.label}>
          {
            LOCALES.map((l) => (
              <a
                href={localeUrl(l.path)}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === locale ? 'true' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>

    <div class="footer-base">
      <span>© 2026 Melissa de Britto&ensp;·&ensp;{t.footer.license}</span>
      <span class="footer-also">
        {t.footer.also}{' '}
        <a href={SUMSIGHT} target="_blank" rel="noopener">Sumsight ↗</a>
      </span>
    </div>
  </div>
</footer>
