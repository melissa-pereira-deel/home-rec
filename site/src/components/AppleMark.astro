---
// The Apple glyph used inside the download buttons. Unchanged path data from
// the previous site — extracted to a component so the three call sites can't
// drift, and so the buttons stay a single line of markup.
interface Props {
  size?: number;
}
const { size = 13 } = Astro.props;
---
