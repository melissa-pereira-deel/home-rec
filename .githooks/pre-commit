#!/usr/bin/env bash
#
# Home Rec pre-commit hook — blocks secrets and internal PM docs from
# entering the public repository.
#
# Setup (run once per clone — git config is not cloned):
#   git config core.hooksPath .githooks
#
# Bypass (only when you are certain a match is a false positive):
#   git commit --no-verify
#
set -euo pipefail

RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'; NC=$'\033[0m'
BLOCKED=0

# ── 1. Filename blocklist ──────────────────────────────────────────────
# High-confidence: these paths/extensions must never be public.
#
# ⚠️ `[-_]`, not `_`. Tested in a throwaway repo 2026-08-02: the underscore-only
# spelling let `sparkle-private-key.txt` through — the exact filename the
# Sparkle key backup was written to on this machine. Hyphens are the more
# natural spelling and were the one this list missed.
FILE_PATTERNS='(^|/)\.env(\..*)?$|(^|/)private/|(^|/)BACKLOG\.md$|.*\.private\.md$|(^|/)secrets\.|(^|/)notariz.*\.txt$|\.(p12|cer|p8|key|pem|mobileprovision|provisionprofile)$|[-_]priv(ate)?[-_]?key|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)(sparkle|signing)[-_].*key|(^|/)AuthKey_.*\.p8$|appcast.*\.key$|(^|/)docs/product-strategy/'

staged=$(git diff --cached --name-only --diff-filter=ACM || true)

while IFS= read -r f; do
  [ -z "$f" ] && continue
  if printf '%s\n' "$f" | grep -Eq "$FILE_PATTERNS"; then
    echo "${RED}✖ Blocked file:${NC} $f"
    BLOCKED=1
  fi
done <<< "$staged"

# ── 2. Content scan (unambiguous secret material in staged diff) ───────
#
# The last alternative is the important one and the least obvious: a raw
# Ed25519 seed — the Sparkle signing key — is 43 base64 characters plus one '='
# and carries no header, prefix or armour. Every other rule here keys off a
# recognisable marker, so all of them miss it, and so does every hosted secret
# scanner. This shape rule is the only control that covers the single most
# damaging secret in the project.
#
# `SUPublicEDKey` is the same shape by construction, so it is filtered out
# first. Filter by the key name, never by the literal value: pinning the
# current public key here would silently disarm the rule the day it rotates.
if git diff --cached -U0 \
  | grep -v 'SUPublicEDKey' \
  | grep -Eq -- \
  '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|sk_live_[0-9A-Za-z]{16,}|(gh[pousr]_[A-Za-z0-9]{36})|github_pat_[A-Za-z0-9_]{22,}|(^|[^A-Za-z0-9+/])[A-Za-z0-9+/]{43}=([^A-Za-z0-9+/]|$)|[^a-z-]([a-z]{4}-){3}[a-z]{4}[^a-z-]'; then
  echo "${RED}✖ Blocked:${NC} staged content matches a private key or live API token pattern."
  echo "  (A bare 44-char base64 string is the shape of an Ed25519 signing key.)"
  BLOCKED=1
fi

if [ "$BLOCKED" -ne 0 ]; then
  echo ""
  echo "${YEL}Commit aborted by the Home Rec pre-commit hook.${NC}"
  echo "The items above are internal or sensitive and must not reach the public repo."
  echo "Move internal docs under private/ and keep secrets in Keychain."
  echo "If this is genuinely a false positive: ${GRN}git commit --no-verify${NC}"
  exit 1
fi

exit 0
