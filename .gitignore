# ─── Product management / internal (NEVER publish) ───
# All internal docs live under private/. The folder is the structural
# guarantee: anything here physically cannot be committed.
/private/
BACKLOG.md
docs/product-strategy/
*.private.md

# ─── Marketing artifacts (keep local, publish via website host) ───
home-rec-website.html
privacy.html
terms.html
favicon.svg
favicon.ico
apple-touch-icon.png

# The website is its own repo (home-rec-site) and deploys from there.
# A local copy here would be a second, silently-diverging source of truth.
home-rec-site-main/

# Vercel deploy config — describes how the website is deployed, not how the
# app is built. Kept local alongside the website HTML files.
vercel.json
.vercelignore
.vercel/

# Build logs from scripts/build-dmg.sh (contain local paths + submission IDs)
dist-build.log

